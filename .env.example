# --- Supabase (required) -----------------------------------------------------
# Project Settings -> API. The anon key is safe for the browser; Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS. Used ONLY by /api/billing/webhook to apply a confirmed plan. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini (required for AI features) ---------------------------------------
# Server-side only. Use a key from a billing-enabled (paid) Google AI project.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Payment links (you provide these; no payment gateway is built in) -------
STARTER_PAYMENT_LINK=
PRO_PAYMENT_LINK=
SCALE_PAYMENT_LINK=

# Shared secret (24+ random characters) that authenticates calls to /api/billing/webhook.
BILLING_WEBHOOK_SECRET=

# --- Site ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://secureshieldai.click
NEXT_PUBLIC_CONTACT_EMAIL=hello@secureshieldai.click
NEXT_PUBLIC_COMPANY_NAME=SecureShield AI
